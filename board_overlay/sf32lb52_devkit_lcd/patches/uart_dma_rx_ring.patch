+        g_uart_rx_diag[(unsigned)(uart - uart_obj)].overruns++;
         __HAL_UART_CLEAR_OREFLAG(&uart->handle);
     }
     if (__HAL_UART_GET_FLAG(&(uart->handle), UART_FLAG_NE) != RESET)
     {
         if (uart->handle.Instance == hwp_usart3) wifi_ne++;
+        g_uart_rx_diag[(unsigned)(uart - uart_obj)].noise_errors++;
         __HAL_UART_CLEAR_NEFLAG(&uart->handle);
     }
     if (__HAL_UART_GET_FLAG(&(uart->handle), UART_FLAG_FE) != RESET)
     {
         if (uart->handle.Instance == hwp_usart3) wifi_fe++;
+        g_uart_rx_diag[(unsigned)(uart - uart_obj)].frame_errors++;
         __HAL_UART_CLEAR_FEFLAG(&uart->handle);
